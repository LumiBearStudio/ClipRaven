    "App Store에서 상품 정보를 찾을 수 없습니다. 인터넷 연결을 확인해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load the purchase from the App Store. Check your internet connection and try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeから購入情報を読み込めませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kauf konnte nicht aus dem App Store geladen werden. Prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger l’achat depuis l’App Store. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar la compra desde el App Store. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare l’acquisto dall’App Store. Controlla la connessione a Internet e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar a compra da App Store. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从 App Store 载入购买项目。请检查网络连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法從 App Store 載入購買項目。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "결제 대기 중입니다. 승인 후 자동으로 잠금이 해제됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment is pending. ClipRaven unlocks automatically once it's approved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いが保留中です。承認されると自動的にロックが解除されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung steht noch aus. ClipRaven wird automatisch freigeschaltet, sobald sie genehmigt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement est en attente. ClipRaven se déverrouillera automatiquement une fois celui-ci approuvé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago está pendiente. ClipRaven se desbloqueará automáticamente cuando se apruebe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pagamento è in attesa. ClipRaven si sbloccherà automaticamente dopo l’approvazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagamento está pendente. O ClipRaven será desbloqueado automaticamente após a aprovação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款待处理。批准后 ClipRaven 会自动解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款處理中。核准後 ClipRaven 會自動解鎖。"
          }
        }
      }
    },
