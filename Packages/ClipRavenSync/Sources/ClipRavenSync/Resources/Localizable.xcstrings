    "추천 — 이미지 미리보기만, 데이터 절약": {
      "comment": "ImageSyncMode .thumbnailOnly summary",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended — preview only, saves data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推奨 — プレビューのみ、データ節約"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐 — 仅预览，节省流量"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfohlen — nur Vorschau, datensparend"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommandé — aperçu uniquement, économe en données"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado — solo vista previa, ahorra datos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦 — 僅預覽，節省流量"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigliato — solo anteprima, risparmia dati"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado — apenas pré-visualização, economiza dados"
          }
        }
      }
    },
