    "원본 paste 가능, iCloud 저장공간 사용": {
      "comment": "ImageSyncMode .full summary",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Originals available for paste, uses iCloud storage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルを貼り付け可、iCloudストレージを使用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可粘贴原图，使用 iCloud 存储"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale zum Einfügen, nutzt iCloud-Speicher"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaux disponibles pour coller, utilise le stockage iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Originales disponibles para pegar, usa almacenamiento iCloud"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可貼上原檔，使用 iCloud 儲存空間"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Originali disponibili per incollare, usa spazio iCloud"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Originais disponíveis para colar, usa armazenamento iCloud"
          }
        }
      }
    },
