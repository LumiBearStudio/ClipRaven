    "이미지는 다른 기기에 보이지 않음": {
      "comment": "ImageSyncMode .off summary",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images are not visible on other devices"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は他のデバイスには表示されません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片不会显示在其他设备"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder erscheinen nicht auf anderen Geräten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images n'apparaîtront pas sur d'autres appareils"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes no aparecerán en otros dispositivos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片不會顯示在其他裝置上"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini non appariranno su altri dispositivi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens não aparecerão em outros dispositivos"
          }
        }
      }
    },
