    "동기화 설정 변경은 ClipRaven을 다시 실행한 후 적용됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync-Einstellungsänderungen werden nach Neustart von ClipRaven wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync setting changes take effect after restarting ClipRaven."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de sync se aplican al reabrir ClipRaven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements de réglage de sync s'appliquent au redémarrage de ClipRaven."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche al sync hanno effetto al riavvio di ClipRaven."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期設定の変更はClipRavenを再起動すると反映されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações no sync entram em vigor após reabrir o ClipRaven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步设置更改将在重新打开 ClipRaven 后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步設定變更將於重新開啟 ClipRaven 後生效。"
          }
        }
      }
    },
