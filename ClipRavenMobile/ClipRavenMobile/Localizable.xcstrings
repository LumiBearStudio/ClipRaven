      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips auf diesem iPhone werden automatisch mit anderen Geräten synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone's clips will be synced automatically to other devices."
          }
