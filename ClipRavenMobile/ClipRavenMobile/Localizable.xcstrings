    "광고 없음.\n구독 없음. 추적 없음.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Werbung.\nKein Abo. Kein Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads.\nNo subscription. No tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin anuncios.\nSin suscripción. Sin rastreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans pub.\nSans abonnement. Sans suivi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente pubblicità.\nNiente abbonamento. Niente tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告なし。\nサブスクなし。追跡なし。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncios.\nSem assinatura. Sem rastreio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无广告。\n无订阅。无追踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無廣告。\n無訂閱。無追蹤。"
          }
        }
      }
    },
    "광고도 추적도 없는,\n평생 쓰는 클립보드": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Werbung, ohne Tracking —\nZwischenablage fürs Leben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads, no tracking,\na clipboard for life"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin anuncios, sin rastreo —\nun portapapeles de por vida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans pub, sans suivi —\nun presse-papiers à vie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza pubblicità né tracciamento —\nappunti per la vita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告も追跡もない、\n一生使えるクリップボード"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncios nem rastreio —\numa área de transferência para a vida"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无广告，无追踪，\n终身使用的剪贴板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無廣告、無追蹤，\n一輩子用的剪貼簿"
          }
        }
      }
    },
