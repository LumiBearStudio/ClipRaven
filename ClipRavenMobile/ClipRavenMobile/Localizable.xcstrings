    "키보드 익스텐션을 활성화하면\n다른 앱에서도 클립을 바로 사용할 수 있어요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Tastatur-Erweiterung,\num deine Clips in jeder App zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the keyboard extension\nto use your clips in any app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la extensión de teclado\npara usar tus clips en cualquier app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l'extension de clavier\npour utiliser vos clips dans toutes les apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l'estensione tastiera\nper usare i tuoi clip in ogni app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード拡張を有効にすれば、\n他のアプリでもクリップをすぐ使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a extensão de teclado\npara usar seus clips em qualquer app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用键盘扩展后，\n在其他应用中也能直接使用剪贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用鍵盤擴充功能後,\n在其他 App 中也能直接使用剪貼。"
          }
        }
      }
    },
