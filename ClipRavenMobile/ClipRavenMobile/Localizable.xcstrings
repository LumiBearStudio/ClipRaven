    "이것은 텍스트 클립 미리보기입니다. 한국어 가독성을 위해 트래킹과 줄간격을 조정했습니다.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau eines Textclips. Laufweite und Zeilenhöhe wurden für koreanische Lesbarkeit angepasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a text clip preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de clip de texto. Tracking e interlineado ajustados para legibilidad en coreano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu d'un clip de texte. Crénage et interligne ajustés pour le coréen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima di un clip di testo. Spaziatura e interlinea ottimizzati per la leggibilità in coreano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはテキストクリップのプレビューです。韓国語の可読性のためトラッキングと行間を調整しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização de clip de texto. Tracking e altura de linha ajustados para legibilidade em coreano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是文本剪贴预览。已调整字距和行高以提升韩文可读性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是文字剪貼預覽。已調整字距與行高以提升韓文可讀性。"
          }
        }
      }
    },
