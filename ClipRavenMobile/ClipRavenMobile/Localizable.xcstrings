    "환영 화면을 처음부터 다시 봅니다. 클립 데이터는 유지됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrüßungsbildschirme erneut anzeigen. Deine Clips bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay the welcome screens from the start. Your clips are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir las pantallas de bienvenida desde el inicio. Tus clips se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejouer l'introduction depuis le début. Vos clips sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci le schermate di benvenuto dall'inizio. I clip vengono mantenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェルカム画面を最初から見ます。クリップデータは保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduzir as telas de boas-vindas do início. Seus clips são mantidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从头重看欢迎画面。剪贴数据将被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從頭重看歡迎畫面。剪貼資料將保留。"
