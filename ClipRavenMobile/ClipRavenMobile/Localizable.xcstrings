    },
    "언어 설정을 적용하려면 ClipRaven을 종료하고 다시 실행해주세요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven beenden und neu starten, um die Sprache anzuwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit and relaunch ClipRaven to apply the language change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra y vuelve a abrir ClipRaven para aplicar el idioma."
          }
