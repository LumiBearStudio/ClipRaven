    "어떤 앱에서든 텍스트를 복사하면\nClipRaven에 자동으로 저장됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere Text in jeder App —\nClipRaven speichert automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy any text in any app, and\nClipRaven saves it automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia cualquier texto en cualquier app:\nClipRaven lo guarda automáticamente."
