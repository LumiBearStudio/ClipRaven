    "비밀번호, 신용카드, API 키 등 민감한 데이터는 자동으로 동기화에서 제외됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensible Daten (Passwörter, Karten, API-Schlüssel) werden automatisch vom Sync ausgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords, credit cards, API keys, and other sensitive data are automatically excluded from sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos sensibles (contraseñas, tarjetas, claves API) se excluyen automáticamente del sync."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sensibles (mots de passe, cartes, clés API) sont auto-exclues de la sync."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati sensibili (password, carte, chiavi API) vengono auto-esclusi dal sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードやカード、APIキーなどの機密データは同期から自動的に除外されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados sensíveis (senhas, cartões, chaves API) são auto-excluídos do sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码、信用卡、API 密钥等敏感数据会自动从同步中排除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感資料 (密碼、卡號、API 金鑰) 會自動從同步中排除。"
          }
        }
      }
    },
