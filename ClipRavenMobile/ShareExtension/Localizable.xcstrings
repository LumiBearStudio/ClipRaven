    "공유 가능한 텍스트 없음": {
      "comment": "Error when shared item has no text content",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shareable text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有可能なテキストがありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无可分享文本"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein freigebbarer Text"
