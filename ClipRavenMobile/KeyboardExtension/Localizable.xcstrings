{
  "sourceLanguage" : "ko",
  "strings" : {
    "'전체 접근 허용'을 활성화해주세요\n설정 → 일반 → 키보드 → ClipRaven" : {
      "comment" : "Hint shown when keyboard extension lacks Full Access permission",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on “Allow Full Access”\nSettings → General → Keyboard → Keyboards → ClipRaven"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「フルアクセスを許可」をオンにしてください\n設定 → 一般 → キーボード → キーボード → ClipRaven"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Vollen Zugriff erlauben“\nEinstellungen → Allgemein → Tastatur → Tastaturen → ClipRaven"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Autoriser l’accès complet »\nRéglages → Général → Clavier → Claviers → ClipRaven"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Permitir acceso completo»\nAjustes → General → Teclado → Teclados → ClipRaven"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Consenti accesso completo»\nImpostazioni → Generali → Tastiera → Tastiere → ClipRaven"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Permitir Acesso Total”\nAjustes → Geral → Teclado → Teclados → ClipRaven"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开“允许完全访问”\n设置 → 通用 → 键盘 → 键盘 → ClipRaven"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開啟「允許完整取用」\n設定 → 一般 → 鍵盤 → 鍵盤 → ClipRaven"
          }
        }
      }
    },
