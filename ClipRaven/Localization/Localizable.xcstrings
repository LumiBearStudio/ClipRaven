    "알림 센터 위젯을 통해 최근 클립과 고정된 클립을 빠르게 확인할 수 있습니다. 위젯 타겟이 설치되어 있어야 합니다.": {
      "comment": "A description of the functionality of the ClipRaven widget in the \"Widget\" section of the General Settings view.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Greife über ein Widget in der Mitteilungszentrale schnell auf aktuelle und angeheftete Clips zu. Das Widget-Target muss installiert sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly access recent and pinned clips through a Notification Center widget. The widget target must be installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede rápidamente a clips recientes y anclados desde un widget del Centro de notificaciones. Debe estar instalado el objetivo del widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez rapidement aux clips récents et épinglés via un widget du Centre de notifications. La cible du widget doit être installée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi rapidamente ai clip recenti e fissati tramite un widget nel Centro notifiche. È necessario installare il target del widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知センターのウィジェットから最近のクリップとピン留めクリップに素早くアクセスできます。ウィジェットターゲットがインストールされている必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesse rapidamente clipes recentes e fixados através de um widget da Central de Notificações. O destino do widget deve estar instalado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过通知中心小组件快速访问最近的剪贴项和固定的剪贴项。需要安装小组件目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過通知中心小工具快速存取最近的剪貼項和釘選的剪貼項。需要安裝小工具目標。"
          }
        }
      }
