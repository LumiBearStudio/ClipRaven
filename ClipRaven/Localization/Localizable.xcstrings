    "클립 저장 시 Apple 온디바이스 AI가 자동으로 카테고리를 분류합니다 (영수증, 이메일, 코드 등).": {
      "comment": "A description of how Apple Intelligence automatically categorizes text clips.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die On-Device-KI von Apple klassifiziert Clips beim Speichern automatisch (Beleg, E-Mail, Code usw.)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple on-device AI automatically classifies clips into categories (receipt, email, code, etc.) when saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA en el dispositivo de Apple clasifica automáticamente los clips al guardarlos (recibo, correo, código, etc.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA sur appareil d'Apple classe automatiquement les clips lors de leur sauvegarde (reçu, e-mail, code, etc.)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA on-device di Apple classifica automaticamente i clip al salvataggio (ricevuta, e-mail, codice, ecc.)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを保存するときに、AppleのオンデバイスAIが自動でカテゴリを分類します(レシート、メール、コードなど)。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA integrada da Apple classifica automaticamente os clipes ao salvar (recibo, e-mail, código etc.)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存剪贴项时,Apple 设备端 AI 会自动分类(如收据、邮件、代码等)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存剪貼項時,Apple 裝置端 AI 會自動分類(如收據、郵件、程式碼等)。"
          }
        }
      }
    },
