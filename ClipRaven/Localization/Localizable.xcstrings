    "시스템 설정 → Apple Intelligence & Siri에서 활성화하고, 모델 다운로드가 완료되어야 분류가 작동합니다.": {
      "comment": "A description of the Apple Intelligence feature, explaining that it",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Systemeinstellungen → Apple Intelligence & Siri aktivieren und auf den Abschluss des Modell-Downloads warten, damit die Klassifizierung funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable in System Settings → Apple Intelligence & Siri, and wait for the model download to complete before classification works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Preferencias del Sistema → Apple Intelligence y Siri, y espera a que termine la descarga del modelo para que funcione la clasificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez dans Réglages Système → Apple Intelligence et Siri, puis attendez la fin du téléchargement du modèle pour que la classification fonctionne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva in Impostazioni di sistema → Apple Intelligence e Siri e attendi il completamento del download del modello per la classificazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → Apple Intelligence と Siri で有効化し、モデルのダウンロードが完了すると分類が動作します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative em Ajustes do Sistema → Apple Intelligence e Siri, e aguarde o download do modelo para que a classificação funcione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系统设置 → Apple Intelligence 与 Siri」中启用,并等待模型下载完成后分类才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
