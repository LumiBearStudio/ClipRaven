    "비밀번호, 신용카드 번호 등 민감한 정보 패턴이 감지되면 클립보드 저장을 건너뜁니다.": {
      "comment": "Description of the sensitive data block feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Muster sensibler Informationen (Passwörter, Kreditkartennummern usw.) erkannt werden, wird das Speichern übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips saving to clipboard history when sensitive data (passwords, credit card numbers, etc.) is detected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se detectan patrones de información sensible (contraseñas, números de tarjeta, etc.), se omite el guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si des motifs d'informations sensibles (mots de passe, numéros de carte, etc.) sont détectés, la sauvegarde est ignorée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vengono rilevati schemi di informazioni sensibili (password, numeri di carta ecc.), il salvataggio viene saltato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードやクレジットカード番号など、機密情報のパターンが検出された場合はクリップボード保存をスキップします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando padrões de informação sensível (senhas, números de cartão etc.) são detectados, o salvamento é ignorado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到密码、信用卡号等敏感信息模式时,跳过剪贴板保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到密碼、信用卡號等敏感資訊模式時,跳過剪貼簿儲存。"
          }
        }
      }
    },
