    "iCloud에 업로드된 모든 ClipRaven 클립을 삭제합니다. 다른 디바이스에서도 다음 동기화 시 사라집니다. 이 Mac의 로컬 데이터는 영향받지 않습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle ClipRaven-Clips aus iCloud. Sie verschwinden beim nächsten Sync auf anderen Geräten. Lokale Daten auf diesem Mac sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all ClipRaven clips uploaded to iCloud. Other devices will lose them on the next sync. Local data on this Mac is unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todos los clips de ClipRaven subidos a iCloud. Desaparecerán de otros dispositivos en la próxima sync. No afecta los datos locales de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime tous les clips ClipRaven d'iCloud. Ils disparaîtront sur les autres appareils à la prochaine sync. Les données locales de ce Mac ne sont pas affectées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutti i clip ClipRaven caricati su iCloud. Spariranno dagli altri dispositivi al prossimo sync. I dati locali su questo Mac non sono interessati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにアップロードされたClipRavenの全クリップを削除します。他のデバイスからも次回同期時に消えます。このMacのローカルデータには影響しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui todos os clips do ClipRaven enviados para o iCloud. Eles desaparecerão dos outros dispositivos na próxima sync. Dados locais neste Mac não são afetados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除已上传到 iCloud 的所有 ClipRaven 剪贴。其他设备下次同步时也会消失。不影响此 Mac 的本地数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除已上傳至 iCloud 的所有 ClipRaven 剪貼。其他裝置在下次同步時也會消失。不影響此 Mac 的本地資料。"
