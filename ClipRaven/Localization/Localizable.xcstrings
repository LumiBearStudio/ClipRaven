    "동기화 비활성화는 ClipRaven을 재시작한 후 적용됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Deaktivieren der Sync wird nach Neustart von ClipRaven wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabling sync takes effect after restarting ClipRaven."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la sync se aplica tras reiniciar ClipRaven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La désactivation de la sync prend effet après le redémarrage de ClipRaven."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disattivazione del sync ha effetto dopo il riavvio di ClipRaven."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期の無効化はClipRavenの再起動後に適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar o sync entra em efeito após reiniciar o ClipRaven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用同步将在重启 ClipRaven 后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用同步將於重新啟動 ClipRaven 後生效。"
          }
        }
      }
    },
    "동기화를 끄면 이 Mac의 클립이 iCloud로 업로드되지 않습니다. 기존에 업로드된 클립은 서버에 남아있으며, 아래 '모두 지우기'로 제거할 수 있습니다.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei deaktivierter Sync werden Clips dieses Macs nicht zu iCloud hochgeladen. Zuvor hochgeladene Clips bleiben auf dem Server — entferne sie mit ‚Alles löschen' unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When sync is off, clips from this Mac are no longer uploaded. Previously-uploaded clips remain on the server; use 'Erase All' below to remove them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con sync desactivada, los clips de este Mac no se suben a iCloud. Los ya subidos permanecen en el servidor; usa «Borrar todo» para eliminarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync désactivée : les clips de ce Mac ne sont pas envoyés vers iCloud. Ceux déjà envoyés restent sur le serveur — utilisez « Tout effacer » ci-dessous pour les retirer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con sync disattivata, i clip di questo Mac non vengono caricati su iCloud. I clip caricati in precedenza restano sul server — usa «Cancella tutto» per rimuoverli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期をオフにすると、このMacのクリップはiCloudへアップロードされません。以前にアップロードされたクリップはサーバーに残ります。下の「すべて消去」で削除できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com sync desativada, os clips deste Mac não são enviados ao iCloud. Os já enviados permanecem no servidor — use «Apagar tudo» abaixo para removê-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步后，此 Mac 的剪贴不会上传到 iCloud。已上传的剪贴仍保留在服务器，可使用下方的「全部清除」移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉同步後，此 Mac 的剪貼不會上傳到 iCloud。已上傳的剪貼仍保留在伺服器，可使用下方的「全部清除」移除。"
          }
        }
      }
    },
