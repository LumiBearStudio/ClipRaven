            "value": "• Texto / Archivo: Pulsa ⌘C dos veces en %@ms para guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Texte / Fichier : Appuyez sur ⌘C deux fois en %@ms pour enregistrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Testo / File: Premi ⌘C due volte entro %@ms per salvare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• テキスト/ファイル: ⌘Cを%@ms以内に2回押して保存"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
