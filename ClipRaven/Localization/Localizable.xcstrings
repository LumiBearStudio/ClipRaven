    "ClipRaven에 손쉬운 사용 권한이 필요합니다. 시스템 설정 → 개인정보 보호 → 손쉬운 사용에서 허용해주세요.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven benötigt Bedienungshilfen-Zugriff. Bitte in Systemeinstellungen → Datenschutz → Bedienungshilfen erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven needs Accessibility permission. Allow it in System Settings → Privacy & Security → Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven necesita permiso de Accesibilidad. Concédelo en Ajustes del sistema → Privacidad → Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven a besoin de l'accès Accessibilité. Autorisez-le dans Réglages système → Confidentialité → Accessibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven richiede l'accesso Accessibilità. Concedilo in Impostazioni di sistema → Privacy → Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRavenにアクセシビリティ権限が必要です。システム設定 → プライバシー → アクセシビリティで許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
