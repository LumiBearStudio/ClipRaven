    "언어 변경은 앱 재시작 후 적용됩니다.": {
      "comment": "Note about language change requiring restart.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachänderungen werden nach Neustart der App übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language change takes effect after restarting the app."
          }
        },
