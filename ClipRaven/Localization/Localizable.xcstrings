    "끄면 화면 전환과 카드 펼침이 즉시 표시됩니다. 시스템의 '동작 줄이기' 설정과 별개입니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren Sie, um Übergänge und Kartenausweitungen sofort anzuzeigen. Unabhängig von der Systemeinstellung „Bewegung reduzieren\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off to make screen transitions and card expansions instant. Independent of the system's 'Reduce Motion' setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para transiciones y expansiones de tarjeta instantáneas. Independiente del ajuste 'Reducir movimiento' del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez pour des transitions et déploiements instantanés. Indépendant du réglage système 'Réduire les animations'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva per transizioni e espansioni di carta istantanee. Indipendente dall'impostazione 'Riduci movimento' di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると画面遷移とカード展開が即時表示になります。システムの「動きを減らす」設定とは独立しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para transições e expansões de cartão instantâneas. Independente da opção 'Reduzir movimento' do sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后画面切换和卡片展开会立即显示。与系统「减少动态效果」设置无关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後畫面切換和卡片展開會立即顯示。與系統「減少動態效果」設定無關。"
          }
        }
      }
    },
