    "ClipRaven이 클립을 iCloud에 안전하게 동기화합니다. iPhone, iPad, 다른 Mac에서도 같은 클립을 사용할 수 있습니다.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven synchronisiert Clips sicher über iCloud, damit du sie auf iPhone, iPad und anderen Macs nutzen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven safely syncs your clips through iCloud. Use the same clips on iPhone, iPad, and other Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven sincroniza los clips de forma segura vía iCloud para usarlos en iPhone, iPad y otros Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven synchronise les clips en toute sécurité via iCloud pour les utiliser sur iPhone, iPad et autres Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven sincronizza i clip in sicurezza via iCloud per usarli su iPhone, iPad e altri Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRavenはクリップをiCloud経由で安全に同期し、iPhone、iPad、他のMacでも同じクリップを使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ClipRaven sincroniza clips com segurança via iCloud para uso em iPhone, iPad e outros Macs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven 通过 iCloud 安全同步剪贴，可在 iPhone、iPad 和其他 Mac 上使用相同剪贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipRaven 透過 iCloud 安全同步剪貼，可在 iPhone、iPad 和其他 Mac 上使用相同剪貼。"
          }
        }
      }
    },
