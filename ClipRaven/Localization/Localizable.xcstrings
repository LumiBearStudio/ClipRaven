          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear dados sensíveis auto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动屏蔽敏感数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動封鎖敏感資料"
          }
        }
      }
    },
    "민감한 데이터(비밀번호, 신용카드, API 키 등)는 자동으로 동기화에서 제외됩니다. '개인정보 보호' 탭에서 추가 앱을 제외할 수 있습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensible Daten (Passwörter, Karten, API-Schlüssel usw.) werden automatisch vom Sync ausgeschlossen. Weitere Apps können im Tab ‚Datenschutz' ausgeschlossen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive data (passwords, credit cards, API keys, etc.) is automatically excluded from sync. Add more apps to exclude in the Privacy tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos sensibles (contraseñas, tarjetas, claves API, etc.) se auto-excluyen del sync. Excluye más apps en la pestaña «Privacidad»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sensibles (mots de passe, cartes, clés API, etc.) sont auto-exclues de la sync. Excluez d'autres apps dans l'onglet « Confidentialité »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati sensibili (password, carte, chiavi API, ecc.) sono auto-esclusi dal sync. Aggiungi altre app da escludere nella scheda «Privacy»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密データ(パスワード、カード、APIキーなど)は同期から自動除外されます。「プライバシー」タブで除外アプリを追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados sensíveis (senhas, cartões, chaves API etc.) são auto-excluídos do sync. Adicione mais apps na aba «Privacidade»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感数据 (密码、卡号、API 密钥等) 自动从同步中排除。可在「隐私」标签中排除更多应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感資料 (密碼、卡號、API 金鑰等) 會自動從同步排除。可在「隱私」分頁中排除更多應用程式。"
          }
        }
      }
    },
