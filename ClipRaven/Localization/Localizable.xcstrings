    "Shortcuts 편집기에서는 붙여넣기를 실행할 수 없습니다. Spotlight(⌘Space), Siri, 또는 자동화(Automation)에서 호출해주세요.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügen kann nicht aus dem Kurzbefehle-Editor ausgeführt werden. Verwende Spotlight (⌘Space), Siri oder eine Automation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot run Paste from the Shortcuts editor. Trigger via Spotlight (⌘Space), Siri, or Automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar no se puede ejecutar desde el editor de Atajos. Llámalo desde Spotlight (⌘Espacio), Siri o una Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller ne peut être déclenché depuis l'éditeur Raccourcis. Utilisez Spotlight (⌘Espace), Siri ou une Automatisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla non può essere avviato dall'editor di Comandi rapidi. Eseguilo via Spotlight (⌘Spazio), Siri o un'Automazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットエディタからは貼り付けを実行できません。Spotlight (⌘Space)、Siri、または自動化から呼び出してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível executar Colar a partir do editor de Atalhos. Use Spotlight (⌘Espaço), Siri ou uma Automação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在快捷指令编辑器中执行粘贴。请通过 Spotlight (⌘Space)、Siri 或自动化触发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從捷徑編輯器執行貼上。請透過 Spotlight (⌘Space)、Siri 或自動化呼叫。"
          }
        }
      }
    },
